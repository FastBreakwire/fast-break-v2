# secrets — never commit
.env
server/.env
*.env.local

node_modules/
npm-debug.log*

.DS_Store
Thumbs.db
.vscode/
.idea/

dist/
.netlify/

# Scout run reports — generated output, one pair of files per day. Not
# checked in by default so daily runs don't bloat history; the code that
# produces them (scout/) is tracked normally.
scout/output/*.md
scout/output/*.json
