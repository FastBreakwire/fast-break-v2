# Fast Break — server-side configuration
# NEVER commit a real key. NEVER reference these from browser JavaScript.

# Highlightly sports data provider.
# Without this key the API layer serves clearly-flagged demo data.
HIGHLIGHTLY_API_KEY=

# Optional override — Highlightly answers on a per-sport subdomain of this
# root (basketball.<root>, soccer.<root>, american-football.<root>).
# Defaults to highlightly.net; only set this for local testing against a
# different host.
HIGHLIGHTLY_ROOT_DOMAIN=

PORT=3000
